# Optional. Defaults to 3000. Accepted values are integers from 1 through 65535.
# PORT=3000
# Optional. Defaults to info. Accepted values: error, warn, info, http, verbose, debug, silly.
# LOG_LEVEL=info
# Optional. Defaults to 127.0.0.1.
# ADSB_HOST=127.0.0.1
# Optional. Defaults to 30003. Accepted values are integers from 1 through 65535.
# ADSB_PORT=30003
# Optional. Use decimal degrees in latitude, longitude order.
# MY_LOCATION=43.0000, -70.0000
# Optional. Defaults to 300 feet above mean sea level.
# MY_ELEVATION=300
# Optional. Defaults to artifacts/nasr/NASR_2026_10_01.sqlite when that file exists.
# NASR_DATABASE_PATH=artifacts/nasr/NASR_2026_10_01.sqlite
